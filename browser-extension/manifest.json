{
  "manifest_version": 3,
  "name": "日迹 · 网页时长",
  "version": "0.1.0",
  "description": "将匹配规则的前台网站记录为独立应用，网页标题按日迹设置采集。",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:4177/*", "http://127.0.0.1:4178/*"],
  "background": { "service_worker": "worker.js" },
  "options_page": "options.html",
  "action": { "default_title": "日迹网页统计设置" },
  "incognito": "not_allowed",
  "key": ""
}
