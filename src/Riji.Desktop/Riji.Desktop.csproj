<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../assets/icons/riji.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Riji.Infrastructure/Riji.Infrastructure.csproj" />
    <ProjectReference Include="../Riji.Windows/Riji.Windows.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Content Include="../../assets/icons/riji.ico"><Link>riji.ico</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content><Content Include="../Riji.Web/dist/**/*"><Link>Web/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../browser-extension/worker.js;../../browser-extension/options.js;../../browser-extension/options.html;../../browser-extension/options.css;../../browser-extension/privacy.html;../../browser-extension/LICENSE.txt;../../browser-extension/manifest.json">
      <Link>extensions/chrome-edge/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../browser-extension/signed/riji-firefox.xpi">
      <Link>extensions/firefox/riji-firefox.xpi</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
